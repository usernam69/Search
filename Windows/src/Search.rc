// The app's icon and its version, which Windows shows in Properties and in
// the taskbar.
#include <windows.h>

IDI_APP ICON "search.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION 1,0,16,0
  PRODUCTVERSION 1,0,16,0
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Office Commun"
      VALUE "FileDescription", "Search"
      VALUE "FileVersion", "1.0.16"
      VALUE "InternalName", "Search"
      VALUE "LegalCopyright", "MIT. Search and the app icon are Office Commun's."
      VALUE "OriginalFilename", "Search.exe"
      VALUE "ProductName", "Search"
      VALUE "ProductVersion", "1.0.16"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
